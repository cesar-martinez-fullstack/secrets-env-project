#!/usr/bin/env sh
# Valida el nombre de la rama (Git Flow) y corre las comprobaciones completas antes de publicar.
branch="$(git symbolic-ref --short -q HEAD || true)"
pattern='^(main|develop|(feature|fix|chore|docs|refactor|test|perf|ci|build|security|style)/[a-z0-9][a-z0-9._-]*|(release|hotfix)/[0-9]+\.[0-9]+\.[0-9]+)$'

if [ -n "$branch" ] && ! printf '%s' "$branch" | grep -Eq "$pattern"; then
  echo "Nombre de rama no válido: '$branch'" >&2
  echo "Usa feature/<nombre>, fix/<nombre>, release/X.Y.Z, hotfix/X.Y.Z (ver docs/GIT_WORKFLOW.md)." >&2
  exit 1
fi

bun run typecheck && bun test
