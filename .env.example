# ─── SecretVault — ejemplo de configuración local ─────────────────────
# Copia este archivo a `.env` en la raíz del monorepo y ajusta lo que necesites.
# La aplicación carga `.env` automáticamente en TODOS los sistemas operativos
# (busca el primer .env desde el directorio de ejecución hacia arriba — sin cross-env).
# Precedencia: variables de entorno reales > valores de .env > defaults del código.

# Puerto HTTP del API + UI (mismo origen)
PORT=3000

# Interfaz de red. 127.0.0.1 = SOLO este equipo (recomendado y por defecto).
# No lo cambies a 0.0.0.0: expondría tu bóveda a toda la red.
HOST=127.0.0.1

# Hosts extra aceptados en Host/Origin, separados por coma (loopback siempre está permitido).
# SV_ALLOWED_HOSTS=

# Tamaño máximo del body HTTP en KB (16–20480) y vida máxima absoluta de sesión en horas.
SV_MAX_BODY_KB=2048
SV_SESSION_MAX_HOURS=12

# Carpeta donde vive secrets.db (en Docker se usa el volumen /app/data)
SV_DATA_DIR=./data

# Carpeta con el frontend compilado (vite build → apps/api/public)
SV_PUBLIC_DIR=./apps/api/public

# Minutos de inactividad antes de que la bóveda se bloquee sola (borra la clave de RAM)
SV_AUTO_LOCK_MINUTES=15

# Iteraciones PBKDF2 al derivar la clave AES-256 (rango permitido: 100.000 – 2.000.000)
SV_PBKDF2_ITERATIONS=600000

# 'true' solo si sirves la app detrás de HTTPS/proxy
SV_COOKIE_SECURE=false
SV_TRUST_PROXY=false

# Ruta explícita alternativa a un archivo .env distinto (opcional)
# SV_ENV_FILE=./config/local.env
