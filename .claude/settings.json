{
  "permissions": {
    "allow": [
      "Bash(bun test:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint:check)",
      "Bash(bun run lint)",
      "Bash(bun run format:check)",
      "Bash(bun run format)",
      "Bash(bun run test:*)",
      "Bash(bun run build:web)",
      "Bash(bun audit)",
      "Bash(bunx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./data/**)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.db-shm)",
      "Edit(./.env)",
      "Edit(./data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dangerous-commands.js\"",
            "timeout": 10,
            "statusMessage": "Verificando comando..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect-secrets.js\"",
            "timeout": 10,
            "statusMessage": "Buscando secretos hardcodeados..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-architecture.js\"",
            "timeout": 60,
            "statusMessage": "Verificando arquitectura..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-config.js\"",
            "timeout": 120,
            "statusMessage": "Verificando configuración..."
          }
        ]
      }
    ]
  }
}
